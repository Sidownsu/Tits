# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id

# Optional: register slash commands instantly in one test guild instead of
# waiting up to an hour for global propagation.
DEBUG_GUILD_ID=

# ─── NVIDIA NIM (Riva / Magpie TTS via NVCF) ──────────────────────────────────
# Get keys at https://build.nvidia.com -> API Keys -> Generate API Key.
# At least NIM_KEY_1 is required; the pool scales to however many you provide.
#
# NOTE: NVIDIA's hosted endpoints are documented for prototyping/development.
# Serving real end users is "production" under NVIDIA's terms and requires an
# NVIDIA AI Enterprise licence. Read NIM-LIMITATIONS.md before going live.
NIM_KEY_1=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NIM_KEY_2=
NIM_KEY_3=
NIM_KEY_4=
NIM_KEY_5=

# Optional per-key weights for the "weighted" strategy, comma separated and
# positionally matched to NIM_KEY_1..5. Defaults to 1 for every key.
NIM_KEY_WEIGHTS=

# NVCF gRPC endpoint + function id for Magpie TTS Multilingual.
NIM_GRPC_ENDPOINT=grpc.nvcf.nvidia.com:443
NIM_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969

# Balancing strategy: round-robin | least-used | weighted | lowest-latency
NIM_STRATEGY=least-used

# Resilience tuning
NIM_MAX_RETRIES=3
NIM_REQUEST_TIMEOUT_MS=15000
NIM_COOLDOWN_MS=60000
NIM_CIRCUIT_FAILURE_THRESHOLD=5
NIM_CIRCUIT_RESET_MS=120000

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key: the bot is a trusted backend and bypasses RLS.
SUPABASE_KEY=your-service-role-key

# ─── Audio ────────────────────────────────────────────────────────────────────
# Magpie models emit 22050 Hz. Discord wants 48000 Hz; ffmpeg resamples.
NIM_SAMPLE_RATE_HZ=22050
AUDIO_BITRATE=64000

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_DIR=./.cache/audio
CACHE_MEMORY_MAX_ENTRIES=500
CACHE_DISK_MAX_BYTES=536870912
CACHE_TTL_SECONDS=604800

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_MESSAGE_CHARS=500
MAX_MESSAGE_CHARS_PREMIUM=2000
USER_COOLDOWN_MS=2000
MAX_QUEUE_SIZE=50

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
